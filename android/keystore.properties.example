# Create a copy of this file named 'keystore.properties' in the /android folder.
# Fill in your release signature details. NEVER check keystore.properties or key files (*.jks, *.keystore) into Git!

storeFile=vibeclip-release-key.jks
storePassword=your_store_password_here
keyAlias=vibeclip-key-alias
keyPassword=your_key_password_here
